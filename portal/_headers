# Security headers for Cloudflare Pages. Keep in step with sws.toml in this
# folder (container image). The portal loads nothing from other origins, so
# no inline scripts or styles and no third-party connections.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cache-Control: no-cache

# "!" drops the no-cache above, since Pages joins repeated headers with a
# comma instead of replacing them.
/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
