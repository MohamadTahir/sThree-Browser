# Proxy Server Configuration
# For web version only - Tauri desktop app doesn't use this

# Proxy server port (default: 3001)
PROXY_PORT=3001

# Allowed origin for CORS (default: http://localhost:1420)
ALLOWED_ORIGIN=http://localhost:1420

# Frontend proxy URL (used by the frontend to connect to proxy)
# Default: http://localhost:3001
VITE_PROXY_URL=http://localhost:3001
